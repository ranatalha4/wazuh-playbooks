<!-- Place inside <ossec_config> in /var/ossec/etc/ossec.conf (manager).
     Replaces the old block that pointed to the non-existent custom-virustotal-public.py -->
<integration>
  <!-- Name of the shell wrapper in /var/ossec/integrations/ (it runs custom-virustotal-ip.py).
       Custom integration names must start with "custom-". -->
  <name>custom-virustotal-ip</name>
  <api_key>REDACTED</api_key>
  <!-- Alerts in ANY of these groups trigger a lookup.
       Only alerts >= <log_alert_level> (8) reach integratord. -->
  <group>fortigate,firewall,traffic</group>
  <alert_format>json</alert_format>
</integration>
